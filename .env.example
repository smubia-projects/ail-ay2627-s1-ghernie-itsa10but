# itsa10but API (server/, Cloud Run) for the SMU BIA AI Lodge demo. Copy to .env; .env is gitignored.
# The Next.js site on Vercel needs one variable: NEXT_PUBLIC_API_BASE = this API's URL.

# Inference gateway (OpenAI-compatible chat completions). Default: the club gateway.
API_BASE_URL=https://api.apiyi.com/v1
# This project's own key from the AI Lodge key bot. Secret: never commit it.
API_KEY=
# Experience Finder, Recruiter and Action Planner (the original's Sonnet agents). Tool calls + JSON answers.
MODEL_NAME=deepseek-v4-1-flash-260910
# Role Scout (the original's Haiku agent).
CHEAP_MODEL_NAME=deepseek-v4-1-flash-260910

# Frontend origins, comma-separated. vercel-setup.sh writes the real Vercel URL here.
CORS_ORIGINS=http://localhost:3000

# API boost reviews per IP per window: one hit per review (four agents, several model calls).
# The central control sheet overrides these; UPSTASH_REDIS_REST_URL/_TOKEN come from the batch's shared env.
RATE_LIMIT_REVIEW_MAX=3
RATE_LIMIT_WINDOW_SECONDS=432000
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
